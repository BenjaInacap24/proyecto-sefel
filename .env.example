# Local development (SQLite). Production settings are configured in Vercel.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production only. Use the Supabase Transaction Pooler connection string (port 6543).
# Add the URL and password in Vercel Environment Variables; never commit real credentials.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
